{
  "name": "juhe-shivi",
  "version": "0.1.0",
  "description": "聚合拾遗 — 跨平台、本地优先的桌面 RSS 阅读器",
  "private": true,
  "author": "聚合拾遗团队",
  "main": "out/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck:node": "tsc -p tsconfig.node.json --noEmit",
    "typecheck:web": "tsc -p tsconfig.web.json --noEmit",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:real-feeds": "node scripts/test-real-feeds.cjs",
    "smoke": "npm run build && node scripts/smoke-1.1.cjs",
    "smoke:db": "npm run build && node scripts/smoke-2.3.cjs",
    "smoke:ui": "npm run build && node scripts/smoke-2.1.cjs",
    "smoke:ui-ipc": "npm run build && node scripts/smoke-2.4-ui-ipc.cjs",
    "smoke:phase2": "npm run build && node scripts/smoke-phase2.cjs",
    "smoke:phase2.5": "npm run build && node scripts/smoke-2.5.cjs"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "fast-xml-parser": "^5.10.0",
    "jsdom": "^24.1.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "rss-parser": "^3.13.0",
    "sanitize-html": "^2.16.0",
    "sql.js": "^1.14.1",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^20.14.10",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/sanitize-html": "^2.16.0",
    "@types/sql.js": "^1.4.11",
    "@types/turndown": "^5.0.5",
    "@vitejs/plugin-react": "^4.3.1",
    "electron": "^31.2.0",
    "electron-vite": "^2.3.0",
    "typescript": "^5.5.3",
    "vite": "^5.3.3",
    "vitest": "^3.2.6"
  }
}
